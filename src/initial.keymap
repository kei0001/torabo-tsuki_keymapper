#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "TD0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LPAR>, <&kp LT>;
        };
        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "TD1";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RPAR>, <&kp GT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layer_0 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp Q  &kp L  &kp U  &kp MINUS  &kp BSPC  &kp F  &kp W  &kp R  &kp Y  &kp P  &trans  &trans  &mt LCTRL E  &mt LSHFT I  &mt LALT A  &mt LGUI O  &kp COMMA  &trans  &trans  &kp K  &mt RGUI T  &mt RALT N  &mt RSHFT S  &mt RCTRL H  &trans  &trans  &kp Z  &kp X  &kp C  &kp V  &kp DOT  &kp TAB  &kp RET  &kp G  &kp D  &kp M  &kp J  &kp B  &trans  &trans  &kp ESC  &bt BT_NXT  &mo 3  &kp LANG2  &kp SPACE  &kp RET  &mo 1  &lt 2 LANG1  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans
            >;
        };
        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans  &trans  &trans  &trans  &kp PRCNT  &trans  &trans  &kp COLON  &kp N4  &kp N5  &kp N6  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &trans  &trans  &trans  &kp PLUS  &kp MINUS  &kp STAR  &kp FSLH  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp SQT  &kp DQT  &kp UNDER  &td0  &td1  &trans  &trans  &trans  &kp CARET  &kp PRCNT  &trans  &trans  &kp EQUAL  &trans  &kp AMPS  &kp LBKT  &kp RBKT  &trans  &trans  &kp STAR  &kp SQT  &kp TILDE  &kp FSLH  &kp HASH  &trans  &trans  &trans  &kp SEMI  &kp COLON  &kp PIPE  &trans  &trans  &trans  &trans  &kp DLLR  &kp AT  &trans  &kp BSLH  &trans  &trans  &trans  &trans  &trans  &kp EXCL  &kp QMARK  &trans  &trans  &kp TAB  &trans  &trans  &trans  &trans  &trans
            >;
        };
        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END  &kp ESC  &trans  &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans  &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp TAB  &trans  &trans  &kp F11  &kp F12  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &trans  &kp SQT  &kp DQT  &kp GRAVE  &kp TILDE  &kp PIPE  &trans  &trans  &trans  &trans  &trans  &kp DEL  &kp TAB  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
